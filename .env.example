# Copy this file to `.env` or `.env.local` in the project root.
#
# Python chat backend URL — `app/api/chat/route.ts` proxies POST requests here (browser stays same-origin).
PYTHON_BACKEND_URL=http://127.0.0.1:8000
#
# Google Gemini — used only by the Python API (`backend/main.py`), never exposed to the browser.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
