# Copy this file to `.env` or `.env.local` in the project root.
#
# Convex deployment URL — required. From `npm run convex:dev` or the Convex dashboard.
# The client calls the `chat:sendChat` action (see `convex/chat.ts`).
NEXT_PUBLIC_CONVEX_URL=
#
# Gemini API key — set in Convex Dashboard → Settings → Environment Variables as GEMINI_API_KEY
# (not in this file for production). Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
